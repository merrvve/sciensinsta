---
import Layout     from '../layouts/Layout.astro';
import Featured   from '../components/Featured.astro';
import ToolsList  from '../components/ToolsList.astro';
import Research   from '../components/Research.astro';
import Contact    from '../components/Contact.astro';
import Newsletter from '../components/Newsletter.astro';
import { tools }  from '../data/tools';
---

<Layout title="Sciensinsta – Home">

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-6 dark:bg-gray-700 dark:text-white duration-300">

    <!-- Featured tools (2/3 width) -->
    <div class="md:col-span-2">
      <Featured tools={tools.slice(0, 3)} />
    </div>

    <!-- Tools list sidebar (1/3 width) -->
    <div class="w-full">
      <ToolsList tools={tools} />
    </div>

    <!-- Recent research (2/3 width) -->
    <div class="md:col-span-2">
      <Research />
    </div>

    <!-- Contact form (2/3 width) + Newsletter (1/3 width) -->
    <div class="md:col-span-2">
      <Contact />
    </div>

    <!-- Newsletter (1/3 width) -->
    <div>
      <Newsletter />
    </div>

  </div>

</Layout>
