---
import Layout from '../layouts/Layout.astro';
import Share  from '../components/Share.astro';

const prompt = `You are a helpful assistant. Organise this text content into summarised slides for a coherent and engaging presentation. Your response should be in JSON object list for slides and each slide should be with properties 'title' and 'content'. The text is: `;
---

<Layout title="Sciensinsta – Text to .pptx Conversion Tool">
<section class="min-h-screen p-6 dark:bg-gray-800 dark:text-white">

  <div class="w-full mb-2 mt-2 font-bold text-lg">
    Text to .pptx Conversion Tools
  </div>
  <div class="mb-4">
    <Share title="Text to .pptx Conversion Tool" link="/text-to-pptx" />
  </div>

  <div class="flex text-md font-semibold mb-5">Please select one of the tools below:</div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

    <!-- Sidebar tabs -->
    <div>
      <ul class="flex-column space-y-4 text-sm font-medium text-gray-500 dark:text-gray-400 md:me-4 mb-4 md:mb-0">
        <li>
          <button
            id="tab-1"
            class="tab-btn inline-flex items-center px-4 py-3 rounded-lg w-full bg-pink-500 text-white hover:bg-pink-600 dark:bg-pink-500 dark:hover:bg-pink-600"
            data-tab="1"
          >
            Text to .pptx Directly (Free)
          </button>
        </li>
        <li>
          <button
            id="tab-2"
            class="tab-btn inline-flex items-center px-4 py-3 rounded-lg w-full bg-gray-50 dark:bg-gray-900 hover:bg-gray-100 dark:hover:bg-gray-700 dark:hover:text-white"
            data-tab="2"
          >
            Create Presentation with ChatGPT (Free)
          </button>
        </li>
      </ul>

      <!-- Tab descriptions -->
      <div id="desc-1" class="tab-desc p-6 bg-gray-50 text-sm text-gray-500 dark:text-gray-400 dark:bg-gray-800 rounded-lg w-full mt-4">
        <h3 class="font-bold text-gray-900 dark:text-white mb-2">Text to .pptx Directly</h3>
        <p>This tool places each paragraph of your text on a new slide without pre-processing. It prepares a workspace before you start working on your presentation.</p>
      </div>
      <div id="desc-2" class="tab-desc hidden p-6 bg-gray-50 text-sm text-gray-500 dark:text-gray-400 dark:bg-gray-800 rounded-lg w-full mt-4">
        <h3 class="font-bold text-gray-900 dark:text-white mb-2">Create Presentation with ChatGPT</h3>
        <p class="mb-2">This tool converts a JSON object list (generated by ChatGPT) into a .pptx file.</p>
        <p class="mb-2">You need access to ChatGPT yourself to use this tool.</p>
        <p>If you prefer an automated option, use a tool that automatically splits text and contacts ChatGPT for you.</p>
      </div>
    </div>

    <!-- Content area -->
    <div class="col-span-2">

      <!-- Tool 1 – direct text -->
      <div id="panel-1" class="tool-panel">
        <label class="font-semibold mb-2 block">Your Text:</label>
        <textarea
          id="text-input"
          class="w-full p-3 border-2 border-gray-200 rounded-lg mt-2 dark:bg-transparent dark:text-white"
          rows="6"
          placeholder="Paste your text here..."
        ></textarea>
        <p class="text-gray-500 text-sm mt-2 mb-4">
          Input text will be split by <strong>two line-breaks</strong> into new slides; each slide's content will be split by <strong>'.'</strong> into bullet points.
        </p>
        <div class="flex justify-end">
          <button id="convert-btn-1" class="bg-pink-500 text-white rounded p-3 hover:bg-pink-600 transition-colors">
            Convert to .pptx
          </button>
        </div>
      </div>

      <!-- Tool 2 – ChatGPT JSON -->
      <div id="panel-2" class="tool-panel hidden">
        <p class="mt-2 mb-2">Please run this prompt, replacing the underlined text with your content:</p>
        <h5 class="font-semibold text-md mb-2">Prompt:</h5>
        <div class="relative py-8 mb-2 border border-gray-300 rounded bg-gray-100 dark:bg-transparent p-3 text-sm dark:text-white">
          "{prompt}<span class="underline">Your content here</span>"
          <button
            id="copy-prompt-btn"
            data-prompt={prompt}
            class="text-xs absolute top-1 right-1 bg-pink-500 hover:bg-pink-700 text-white font-bold py-1 px-2 rounded"
          >
            Copy
          </button>
        </div>
        <p class="text-gray-500 text-sm mt-2 mb-5">
          If you split your content into smaller pieces and run this prompt, the output will be more detailed.
        </p>

        <label class="font-semibold text-md mb-2 block">Resulting JSON:</label>
        <textarea
          id="json-input"
          class="w-full p-3 border-2 border-gray-200 rounded-lg mt-2 dark:bg-transparent dark:text-white"
          rows="6"
          placeholder="Copy and paste the resulting JSON here."
        ></textarea>
        <p class="text-gray-500 text-sm mt-2 mb-4">The JSON object list must be surrounded with square brackets.</p>
        <div class="flex justify-end">
          <button id="convert-btn-2" class="bg-pink-500 text-white rounded p-3 hover:bg-pink-600 transition-colors">
            Convert to .pptx
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Status modal (shared) -->
  <div
    id="status-modal"
    class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50"
  >
    <div class="relative bg-white dark:bg-gray-700 rounded-lg shadow p-6 w-full max-w-md mx-4">
      <button id="modal-close" class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 dark:hover:text-white">
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
        </svg>
      </button>

      <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Status</h3>
      <p id="modal-status" class="text-gray-700 dark:text-gray-400 mb-4"></p>

      <div id="modal-download" class="hidden flex flex-col items-center gap-3 mb-4">
        <a id="download-link" class="flex flex-col items-center rounded-lg hover:bg-gray-100 dark:hover:bg-gray-600 p-2 cursor-pointer">
          <img src="/pptx_icon.png" class="w-16 h-16" alt="pptx" />
          <span class="text-sm mt-1">Download File</span>
        </a>
        <a href="https://www.buymeacoffee.com/mervsenv" target="_blank"
           class="text-pink-500 hover:bg-pink-500 hover:text-white rounded p-2 transition-colors text-sm">
          ☕ Buy me a coffee
        </a>
      </div>

      <div class="flex mt-2">
        <button id="modal-close-btn" class="border text-pink-500 border-pink-500 rounded p-2 hover:text-white hover:bg-pink-500 transition-colors duration-300">
          Close
        </button>
      </div>
    </div>
  </div>

</section>
</Layout>

<script>
  // ─── Tab switching ─────────────────────────────────────────────────────────
  const ACTIVE   = ['bg-pink-500', 'text-white', 'hover:bg-pink-600', 'dark:bg-pink-500', 'dark:hover:bg-pink-600'];
  const INACTIVE = ['bg-gray-50', 'dark:bg-gray-900', 'hover:bg-gray-100', 'dark:hover:bg-gray-700', 'dark:hover:text-white', 'text-gray-500', 'dark:text-gray-400'];

  const tabBtns = document.querySelectorAll<HTMLElement>('.tab-btn');
  const panels  = document.querySelectorAll<HTMLElement>('.tool-panel');
  const descs   = document.querySelectorAll<HTMLElement>('.tab-desc');

  function switchTab(activeTab: string) {
    tabBtns.forEach((b) => {
      const isActive = b.dataset.tab === activeTab;
      b.classList.remove(...(isActive ? INACTIVE : ACTIVE));
      b.classList.add(...(isActive ? ACTIVE : INACTIVE));
    });
    panels.forEach((p) => p.classList.toggle('hidden', p.id !== `panel-${activeTab}`));
    descs.forEach((d)  => d.classList.toggle('hidden', d.id !== `desc-${activeTab}`));
  }

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => switchTab(btn.dataset.tab ?? '1'));
  });

  // Initialise with tab 1 active
  switchTab('1');

  // ─── Modal ────────────────────────────────────────────────────────────────
  const modal         = document.getElementById('status-modal')         as HTMLElement;
  const modalStatus   = document.getElementById('modal-status')         as HTMLElement;
  const modalDownload = document.getElementById('modal-download')       as HTMLElement;
  const downloadLink  = document.getElementById('download-link') as HTMLAnchorElement;

  function openModal(msg: string, isError: boolean, blobUrl?: string) {
    modalStatus.textContent = msg;
    modal.classList.remove('hidden');
    if (!isError && blobUrl) {
      downloadLink.href = blobUrl;
      downloadLink.setAttribute('download', 'presentation.pptx');
      modalDownload.classList.remove('hidden');
      downloadLink.click();
    } else {
      modalDownload.classList.add('hidden');
    }
  }

  function closeModal() { modal.classList.add('hidden'); }
  document.getElementById('modal-close')?.addEventListener('click', closeModal);
  document.getElementById('modal-close-btn')?.addEventListener('click', closeModal);

  // ─── Convert (submit → poll → download) ──────────────────────────────────
  async function convert(text: string, tool: number) {
    if (!text.trim()) {
      openModal('Sorry, the input is empty. Please provide content.', true);
      return;
    }
    if (tool === 2) {
      try { JSON.parse(text); }
      catch {
        openModal('Sorry, this is not valid JSON. Please ask ChatGPT to correct it as a valid JSON object list.', true);
        return;
      }
    }

    openModal('Your request has been queued… Please wait…', false);

    // 1 ── Submit task
    let taskId: string;
    try {
      const res = await fetch('/api/create-slides', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text, tool }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      taskId = data.task_id;
    } catch {
      openModal('Sorry, failed to submit the request. Please try again.', true);
      return;
    }

    // 2 ── Poll until done or failed
    const POLL_INTERVAL = 1500;   // ms
    const MAX_POLLS     = 120;    // 3 min max
    let   polls         = 0;

    const poll = async (): Promise<void> => {
      if (polls++ >= MAX_POLLS) {
        openModal('Sorry, the request timed out. Please try again.', true);
        return;
      }

      let status: string;
      try {
        const res  = await fetch(`/api/task/${taskId}`);
        const data = await res.json();
        status = data.status;

        if (status === 'failed') {
          openModal(`Sorry, an error occurred: ${data.detail ?? 'unknown error'}`, true);
          return;
        }
      } catch {
        openModal('Sorry, lost connection while waiting for the file. Please try again.', true);
        return;
      }

      if (status === 'queued' || status === 'processing') {
        const label = status === 'queued' ? 'Queued…' : 'Creating your file…';
        modalStatus.textContent = label;
        setTimeout(poll, POLL_INTERVAL);
        return;
      }

      // 3 ── Done — fetch the file and trigger download
      if (status === 'done') {
        try {
          const fileRes = await fetch(`/api/download-pptx/${taskId}`);
          if (!fileRes.ok) throw new Error(`HTTP ${fileRes.status}`);
          const blobUrl = URL.createObjectURL(await fileRes.blob());
          openModal(
            'Your file is ready. The download will start automatically. You can also click below:',
            false,
            blobUrl,
          );
        } catch {
          openModal('File ready but download failed. Please try again.', true);
        }
      }
    };

    setTimeout(poll, POLL_INTERVAL);
  }

  document.getElementById('convert-btn-1')?.addEventListener('click', () => {
    convert((document.getElementById('text-input') as HTMLTextAreaElement).value, 1);
  });
  document.getElementById('convert-btn-2')?.addEventListener('click', () => {
    convert((document.getElementById('json-input') as HTMLTextAreaElement).value, 2);
  });

  // ─── Copy prompt (reads text from data-prompt attribute) ─────────────────
  const copyPromptBtn = document.getElementById('copy-prompt-btn') as HTMLButtonElement;
  copyPromptBtn?.addEventListener('click', async () => {
    const text = copyPromptBtn.dataset.prompt ?? '';
    await navigator.clipboard.writeText(text);
    copyPromptBtn.textContent = 'Copied!';
    setTimeout(() => { copyPromptBtn.textContent = 'Copy'; }, 2000);
  });
</script>
