---
---

<div id="contact" class="w-full m-2 mb-5 font-bold text-lg underline decoration-pink-500 decoration-dashed underline-offset-8">
  Contact &amp; Feedback
</div>

<form
  action="https://formsubmit.co/mervsen@gmail.com"
  method="POST"
  class="flex flex-col p-4 bg-white rounded-lg md:p-8 dark:bg-gray-800 shadow-sm shadow-pink-500 mb-5"
>
  <!-- FormSubmit config -->
  <input type="hidden" name="_subject"  value="New message from Sciensinsta" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha"  value="false" />

  <label for="contact-email" class="mb-3">Your Email:</label>
  <input
    id="contact-email"
    type="email"
    name="email"
    required
    class="bg-gray-100 p-2 rounded mb-5 dark:bg-transparent border-2 border-white dark:border-gray-600 focus:outline-none focus:border-pink-400 dark:text-white"
    placeholder="Your Email Address"
  />

  <label for="contact-message" class="mb-3">Your Message:</label>
  <textarea
    id="contact-message"
    name="message"
    required
    class="bg-gray-100 mb-10 rounded p-2 dark:bg-transparent border-2 border-white dark:border-gray-600 focus:outline-none focus:border-pink-400 dark:text-white"
    rows="4"
    placeholder="Your Message"
  ></textarea>

  <button
    type="submit"
    class="inline-flex items-center justify-center gap-2 p-2 rounded bg-pink-500 text-white hover:bg-pink-600 mb-5 md:w-1/4 transition-colors"
  >
    Send
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </button>

</form>
