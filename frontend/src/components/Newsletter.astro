---
---

<div class="w-full m-2 mb-5 font-bold text-lg underline decoration-pink-500 decoration-dashed underline-offset-8">
  Newsletter
</div>

<div class="flex flex-col p-4 bg-white rounded-lg md:p-8 dark:bg-gray-800 shadow-sm shadow-pink-500 mb-5">

  <label for="newsletter-email" class="mb-8">
    Please let me know when a new feature is released:
  </label>

  <input
    id="newsletter-email"
    type="email"
    class="bg-gray-100 mb-10 rounded dark:bg-transparent border-2 border-white dark:border-gray-600 p-2 focus:outline-none focus:border-pink-400 dark:text-white"
    placeholder="Your Email Address"
  />

  <button
    id="newsletter-submit"
    class="inline-flex items-center justify-center gap-2 p-2 rounded bg-pink-500 text-white hover:bg-pink-600 mb-5 md:w-1/3 transition-colors"
  >
    Subscribe
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </button>

  <!-- Success alert -->
  <div id="newsletter-success" class="hidden flex items-center p-4 mb-4 text-green-800 rounded-lg bg-green-50 dark:bg-gray-800 dark:text-green-400" role="alert">
    <svg class="flex-shrink-0 w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
      <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
    </svg>
    <span class="sr-only">Info</span>
    <div class="ms-3 text-sm font-medium">Your email has been successfully saved.</div>
    <button id="newsletter-success-close" type="button" class="ms-auto -mx-1.5 -my-1.5 bg-green-50 text-green-500 rounded-lg focus:ring-2 focus:ring-green-400 p-1.5 hover:bg-green-200 inline-flex items-center justify-center h-8 w-8 dark:bg-gray-800 dark:text-green-400 dark:hover:bg-gray-700" aria-label="Close">
      <span class="sr-only">Close</span>
      <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6" />
      </svg>
    </button>
  </div>

  <!-- Error alert -->
  <div id="newsletter-error" class="hidden flex items-center p-4 mb-4 text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400" role="alert">
    <svg class="flex-shrink-0 w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
      <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
    </svg>
    <span class="sr-only">Info</span>
    <div class="ms-3 text-sm font-medium">
      An error occurred while saving your email. Please try again or contact us at
      <a href="mailto:mervsen@gmail.com" class="underline">mervsen@gmail.com</a>.
    </div>
    <button id="newsletter-error-close" type="button" class="ms-auto -mx-1.5 -my-1.5 bg-red-50 text-red-500 rounded-lg focus:ring-2 focus:ring-red-400 p-1.5 hover:bg-red-200 inline-flex items-center justify-center h-8 w-8 dark:bg-gray-800 dark:text-red-400 dark:hover:bg-gray-700" aria-label="Close">
      <span class="sr-only">Close</span>
      <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6" />
      </svg>
    </button>
  </div>

</div>

<script>
  const emailInput  = document.getElementById('newsletter-email') as HTMLInputElement;
  const submitBtn   = document.getElementById('newsletter-submit')!;
  const successBox  = document.getElementById('newsletter-success')!;
  const errorBox    = document.getElementById('newsletter-error')!;

  document.getElementById('newsletter-success-close')?.addEventListener('click', () => {
    successBox.classList.add('hidden');
  });
  document.getElementById('newsletter-error-close')?.addEventListener('click', () => {
    errorBox.classList.add('hidden');
  });

  submitBtn?.addEventListener('click', async () => {
    successBox.classList.add('hidden');
    errorBox.classList.add('hidden');

    const email = emailInput.value.trim();
    if (!email) return;

    try {
      const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const res = await fetch('/api/add-notify-list', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, timezone }),
      });
      if (!res.ok) throw new Error('Server error');
      successBox.classList.remove('hidden');
      emailInput.value = '';
    } catch {
      errorBox.classList.remove('hidden');
    }
  });
</script>
