---
const news = [
  { text: '"Text to .pptx Conversion Tool" is coming soon.', date: '6/12/2023' },
  { text: 'First Tool: "PDF Text and Images Extraction Tool" is released.', date: '6/12/2023' },
];
---

<div class="w-full m-2 mb-10 font-bold text-lg underline decoration-pink-500 decoration-dashed underline-offset-8">
  News
</div>

<ul
  id="release-list"
  class="max-w-md text-gray-600 text-sm dark:text-slate-200 divide-y divide-gray-200 dark:divide-gray-700 dark:bg-gray-800 p-6 rounded-lg shadow-sm shadow-pink-500"
>
  {news.map((item, i) => (
    <li class={`${i === 0 ? 'pb-3 sm:pb-4' : 'pt-3 pb-3 sm:pb-4'} release-item`}>
      <div class="flex items-center justify-between space-x-4">
        <span>{item.text}</span>
        <span class="text-xs text-gray-400 whitespace-nowrap">{item.date}</span>
      </div>
    </li>
  ))}

  <li class="pt-3 pb-0 sm:pt-4 flex gap-4 text-gray-500 dark:text-gray-400">
    <button id="release-see-all" class="hover:text-pink-700 dark:hover:text-pink-400 transition-colors">See All</button>
    <button id="release-expand"  class="hover:text-pink-700 dark:hover:text-pink-400 transition-colors">Expand</button>
  </li>
</ul>

<script>
  // Simple expand/collapse for the news list
  const items    = Array.from(document.querySelectorAll<HTMLElement>('.release-item'));
  const LIMIT    = 2;
  let expanded   = false;

  function render() {
    items.forEach((el, i) => {
      el.style.display = (!expanded && i >= LIMIT) ? 'none' : '';
    });
  }

  document.getElementById('release-expand')?.addEventListener('click', () => {
    expanded = !expanded;
    render();
  });

  document.getElementById('release-see-all')?.addEventListener('click', () => {
    expanded = true;
    render();
  });

  render();
</script>
